# SwingBot AI — secrets (à exporter en variables d'environnement).
# NE JAMAIS committer un fichier .env rempli. Secrets hors base et hors config.

# --- Capital.com (commencer par le compte DÉMO) ---
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# --- Telegram (optionnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analyste IA (optionnel — ai.enabled=true dans config/settings.json) ---
ANTHROPIC_API_KEY=

# --- Verrou n°1 du mode réel (les verrous 2 et 3 sont la checklist Go/No-Go
#     et la double confirmation interactive). Ne poser qu'après validation
#     complète backtest -> shadow -> démo (sections 12-13 des specs). ---
# SWINGBOT_REAL_MODE_I_ACCEPT_LOSSES=YES
