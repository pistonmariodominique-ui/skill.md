//@version=5
// ═══════════════════════════════════════════════════════════════════════════
// VoltScore ⚡ — L'indicateur personnalisé de VoltBot (TradingView, graphique M15)
// ═══════════════════════════════════════════════════════════════════════════
// Condense la logique complète de VoltBot en UN score 0-100 :
//   A. Expansion de volatilité (0-25)  — le cœur : vol_ratio dans la zone en or
//   B. Force de tendance (0-25)        — EMA20/50 M15 + alignement EMA200 1H
//   C. Cassure Donchian (0-25)         — fraîcheur de la cassure du canal 20
//   D. Qualité du momentum (0-25)      — corps des bougies alignés avec le signal
//
// Lecture :
//   ≥ 70  = setup A+  (ce que le bot cherche : cassure fraîche en expansion de vol)
//   55-69 = setup B   (surveiller, attendre la confirmation M5)
//   < 55  = pas de trade (c'est la sortie normale, ne force JAMAIS)
// La couleur de fond donne la DIRECTION (vert = biais BUY, rouge = biais SELL).
// À utiliser sur : GOLD, SILVER, NATGAS, OIL, US30, BTCUSD, ETHUSD — en M15.
// ═══════════════════════════════════════════════════════════════════════════

indicator("VoltScore ⚡ VoltBot", shorttitle="VoltScore", overlay=false, precision=0)

// ── Réglages (mêmes valeurs que volt_settings par défaut) ──
volMin      = input.float(0.7,  "Vol ratio min (marché endormi en dessous)", step=0.1)
volMax      = input.float(3.0,  "Vol ratio max (chaos au-dessus)", step=0.1)
volSweetLo  = input.float(1.0,  "Début de la zone en or", step=0.1)
volSweetHi  = input.float(1.8,  "Fin de la zone en or", step=0.1)
donchLen    = input.int(20,     "Canal Donchian")
scoreA      = input.int(70,     "Seuil setup A+")
scoreB      = input.int(55,     "Seuil setup B")

// ── Indicateurs de base (identiques au code du bot) ──
atr14    = ta.atr(14)
atrRef   = ta.sma(ta.tr, 200)               // TR moyen 200 bougies ≈ atrRef du bot
volRatio = atrRef > 0 ? atr14 / atrRef : 1.0
ema20    = ta.ema(close, 20)
ema50    = ta.ema(close, 50)
ema200H1 = request.security(syminfo.tickerid, "60", ta.ema(close, 200), barmerge.gaps_off, barmerge.lookahead_off)
donchHi  = ta.highest(high, donchLen)[1]    // canal EXCLUANT la bougie courante
donchLo  = ta.lowest(low, donchLen)[1]

// ── Direction du biais (comme le bot : EMA + filtre 1H strict) ──
biasEma  = ema20 > ema50 ? 1 : -1
bias1h   = close > ema200H1 * 1.001 ? 1 : close < ema200H1 * 0.999 ? -1 : 0
// Le bot n'autorise que le sens du 1H (ou neutre) : divergence M15/1H = pas de trade
dirOk    = bias1h == 0 or biasEma == bias1h
direction = dirOk ? biasEma : 0

// ── A. Expansion de volatilité (0-25) ──
// 0 sous volMin (coma) et au-delà de volMax (chaos). Max dans la zone en or.
scoreVol = 0.0
if volRatio >= volMin and volRatio <= volMax
    if volRatio < volSweetLo
        scoreVol := 10 * (volRatio - volMin) / math.max(volSweetLo - volMin, 0.01) + 5
    else if volRatio <= volSweetHi
        scoreVol := 25
    else
        scoreVol := 25 * (volMax - volRatio) / math.max(volMax - volSweetHi, 0.01)
scoreVol := math.max(math.min(scoreVol, 25), 0)

// ── B. Force de tendance (0-25) ──
// Écart EMA20/50 normalisé par l'ATR (au moins 0.3×ATR pour sortir du RANGE),
// bonus si le 1H est aligné.
trendStrength = atr14 > 0 ? math.abs(ema20 - ema50) / atr14 : 0
scoreTrend = math.min(trendStrength / 1.0, 1.0) * 18
scoreTrend := scoreTrend + (bias1h == biasEma and bias1h != 0 ? 7 : bias1h == 0 ? 3 : 0)
scoreTrend := dirOk ? math.min(scoreTrend, 25) : 0

// ── C. Cassure Donchian (0-25) — la fraîcheur compte ──
// Cassure = clôture au-delà du canal. Score max quand la cassure vient d'avoir
// lieu (≤ 3 bougies) puis décroît : une cassure vieille est déjà consommée.
breakUp   = close > donchHi
breakDown = close < donchLo
barsSinceUp   = ta.barssince(breakUp and not breakUp[1])
barsSinceDown = ta.barssince(breakDown and not breakDown[1])
freshness(bs) => na(bs) ? 0.0 : bs <= 3 ? 1.0 : bs <= 8 ? 0.6 : bs <= 15 ? 0.3 : 0.0
scoreBreak = 0.0
if direction == 1 and breakUp
    scoreBreak := 25 * freshness(barsSinceUp)
if direction == -1 and breakDown
    scoreBreak := 25 * freshness(barsSinceDown)
// Proximité de cassure (pré-signal) : à moins de 0.5×ATR du canal → petit score
if scoreBreak == 0 and direction == 1 and (donchHi - close) < 0.5 * atr14
    scoreBreak := 8
if scoreBreak == 0 and direction == -1 and (close - donchLo) < 0.5 * atr14
    scoreBreak := 8

// ── D. Qualité du momentum (0-25) ──
// Corps des 3 dernières bougies : gros corps alignés avec la direction = vraie
// poussée ; mèches géantes = indécision. (Le bot ajoute le spread/ATR côté serveur.)
bodyQuality(idx) =>
    rng = high[idx] - low[idx]
    rng > 0 ? (close[idx] - open[idx]) / rng : 0.0
mom = (bodyQuality(0) + bodyQuality(1) + bodyQuality(2)) / 3
scoreMom = direction != 0 ? math.max(math.min(mom * direction, 1.0), 0.0) * 25 : 0.0

// ── Score final ──
voltScore = direction != 0 ? scoreVol + scoreTrend + scoreBreak + scoreMom : 0.0

// ── Affichage ──
colA = color.new(#3987e5, 0)
colB = color.new(#eda100, 0)
colN = color.new(#898781, 40)
barColor = voltScore >= scoreA ? colA : voltScore >= scoreB ? colB : colN
plot(voltScore, "VoltScore", style=plot.style_columns, color=barColor)
hline(scoreA, "Setup A+", color=color.new(#3987e5, 50), linestyle=hline.style_dashed)
hline(scoreB, "Setup B",  color=color.new(#eda100, 50), linestyle=hline.style_dashed)
bgcolor(voltScore >= scoreB ? (direction == 1 ? color.new(color.green, 88) : color.new(color.red, 88)) : na)

// ── Alertes (pour recevoir les setups sans regarder l'écran) ──
alertcondition(voltScore >= scoreA and direction == 1,  "VoltScore A+ BUY",  "⚡ VoltScore ≥70 BUY — cassure en expansion de volatilité")
alertcondition(voltScore >= scoreA and direction == -1, "VoltScore A+ SELL", "⚡ VoltScore ≥70 SELL — cassure en expansion de volatilité")

// ── Table de lecture rapide ──
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "VoltScore", text_color=color.white, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 1, 0, str.tostring(math.round(voltScore)), text_color=barColor, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 0, 1, "Vol ratio", text_color=color.gray,  bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 1, 1, str.tostring(volRatio, "#.##"), text_color=color.white, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 0, 2, "Direction", text_color=color.gray,  bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 1, 2, direction == 1 ? "BUY ▲" : direction == -1 ? "SELL ▼" : "—", text_color=direction == 1 ? color.green : direction == -1 ? color.red : color.gray, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 0, 3, "Cassure", text_color=color.gray, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 1, 3, str.tostring(math.round(scoreBreak)) + "/25", text_color=color.white, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 0, 4, "Tendance", text_color=color.gray, bgcolor=color.new(#1a1a19, 0))
    table.cell(t, 1, 4, str.tostring(math.round(scoreTrend)) + "/25", text_color=color.white, bgcolor=color.new(#1a1a19, 0))
